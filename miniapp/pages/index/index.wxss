page { height: 100%; overflow: hidden; }
.home {
  position: relative; min-height: 100vh; overflow: hidden;
  padding: calc(env(safe-area-inset-top) + 34rpx) 48rpx 46rpx;
  background: linear-gradient(180deg, #f7d9cc 0%, #f5e7d6 35%, #d9ddc7 72%, #b9c3a7 100%);
  box-sizing: border-box;
}
.home::before, .home::after {
  content: ""; position: absolute; bottom: -8%; border-radius: 50% 50% 0 0;
  background: rgba(91, 113, 78, .34); filter: blur(2rpx);
}
.home::before { left: -30%; width: 108%; height: 32%; transform: rotate(5deg); }
.home::after { right: -38%; width: 112%; height: 27%; background: rgba(70, 94, 64, .28); transform: rotate(-6deg); }
.morning-glow {
  position: absolute; top: -150rpx; right: -120rpx; width: 520rpx; height: 520rpx;
  border-radius: 50%; background: radial-gradient(circle, rgba(255,249,211,.94), rgba(255,229,196,.25) 55%, transparent 72%);
  animation: breathe 5s ease-in-out infinite;
}
.mist { position: absolute; width: 620rpx; height: 130rpx; border-radius: 50%; background: rgba(255,255,255,.22); filter: blur(24rpx); animation: drift 11s ease-in-out infinite alternate; }
.mist-a { top: 31%; left: -260rpx; }.mist-b { top: 49%; right: -300rpx; animation-delay: -4s; }
.brand { position: relative; z-index: 5; display: flex; align-items: center; gap: 16rpx; color: #624940; }
.brand-mark { width: 58rpx; height: 58rpx; display: grid; place-items: center; border: 2rpx solid rgba(126,68,65,.55); border-radius: 18rpx; color: #8f4f52; font-family: serif; font-size: 32rpx; transform: rotate(-3deg); }
.brand-cn,.brand-en { display:block }.brand-cn { font: 600 27rpx/1.2 serif; letter-spacing: 5rpx; }.brand-en { margin-top: 5rpx; font-size: 14rpx; letter-spacing: 4rpx; opacity: .62; }
.hero { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: center; padding-top: 38rpx; text-align: center; }
.character-wrap { position: relative; width: 260rpx; height: 260rpx; opacity: 0; transform: translateY(34rpx) scale(.92); transition: opacity 1s ease, transform 1.2s cubic-bezier(.2,.8,.2,1); }
.character-wrap.is-ready { opacity: 1; transform: translateY(0) scale(1); }
.halo { position: absolute; inset: 8rpx; border-radius: 50%; background: radial-gradient(circle, rgba(255,245,211,.78), rgba(255,233,211,.18) 55%, transparent 70%); animation: breathe 4.5s ease-in-out infinite; }
.character { position: absolute; left: 50%; bottom: 14rpx; width: 166rpx; height: 182rpx; transform: translateX(-50%); animation: float 4.8s ease-in-out infinite; }
.character-face { position: absolute; z-index: 2; top: 0; left: 20rpx; width: 126rpx; height: 132rpx; display: grid; place-items: center; border-radius: 48% 48% 45% 45%; background: linear-gradient(145deg,#9a7258,#6f5142); box-shadow: inset 0 0 0 12rpx rgba(244,199,157,.25), 0 18rpx 32rpx rgba(76,52,41,.18); }
.character-seal { color: #f8d9b0; font: 600 62rpx serif; text-shadow: 0 2rpx 8rpx rgba(41,25,19,.4); }
.character-ear { position:absolute; z-index:1; top:42rpx; width:46rpx; height:60rpx; border-radius:50%; background:#7d5b48; }.character-ear.left{left:0}.character-ear.right{right:0}
.peach-cape { position:absolute; left:0; right:0; bottom:0; height:88rpx; border-radius:80rpx 80rpx 24rpx 24rpx; background:linear-gradient(135deg,#c66d7f,#9b5265); box-shadow:0 15rpx 28rpx rgba(128,67,80,.2); }
.welcome-wave { position:absolute; right:-2rpx; top:36rpx; padding:8rpx 15rpx; border-radius:20rpx 20rpx 20rpx 5rpx; background:rgba(255,250,239,.92); color:#965466; font:600 25rpx serif; animation: wave 3s ease-in-out infinite; }
.identity { margin-top: -5rpx; }.kicker { display:block; color:#8f5b53; font-size:20rpx; letter-spacing:5rpx; }.title { display:block; margin-top:10rpx; color:#493a33; font:600 56rpx/1.25 serif; letter-spacing:5rpx; }.descriptor { display:block; margin-top:12rpx; color:rgba(68,57,49,.67); font-size:21rpx; letter-spacing:1rpx; }
.dialogue { width: 100%; min-height: 142rpx; margin-top: 34rpx; padding: 24rpx 30rpx; border: 1rpx solid rgba(255,255,255,.58); border-radius: 32rpx 32rpx 32rpx 10rpx; background: rgba(255,251,243,.7); box-shadow: 0 18rpx 50rpx rgba(94,70,55,.1); backdrop-filter: blur(16rpx); text-align:left; box-sizing:border-box; transition: transform .4s ease, background .4s ease; }
.dialogue.is-listening { transform: translateY(-5rpx); background:rgba(255,248,238,.9); }
.dialogue-dot { float:left; width:10rpx; height:10rpx; margin:16rpx 16rpx 0 0; border-radius:50%; background:#c77486; box-shadow:0 0 0 8rpx rgba(199,116,134,.13); }
.greeting { display:block; color:#59443b; font:600 29rpx/1.6 serif; animation: copyIn .7s ease; }.hint { display:block; padding-left:26rpx; color:#79675d; font-size:23rpx; line-height:1.8; }.listening { display:block; padding:6rpx 0 0 26rpx; color:#a15a68; font-size:20rpx; }
.actions { position:absolute; z-index:6; left:48rpx; right:48rpx; bottom:calc(env(safe-area-inset-bottom) + 68rpx); }
.primary,.quiet { width:100%; border:0; }
.primary { height:100rpx; display:flex; align-items:center; justify-content:center; gap:24rpx; border-radius:32rpx; background:linear-gradient(135deg,#bd6679,#d38291); color:#fffaf4; font-size:29rpx; font-weight:600; letter-spacing:3rpx; box-shadow:0 20rpx 38rpx rgba(140,73,88,.22); }
.arrow { font-size:38rpx; font-weight:300; }.quiet { margin-top:12rpx; background:transparent; color:rgba(67,57,49,.64); font-size:22rpx; }
.relax-tip { position:absolute; z-index:4; bottom:34rpx; left:0; right:0; text-align:center; color:rgba(70,65,55,.47); font-size:18rpx; letter-spacing:2rpx; }
.leaf { position:absolute; z-index:2; color:rgba(94,120,76,.42); font-size:65rpx; animation: leaf 7s ease-in-out infinite; }.leaf-a{left:2%;top:22%;transform:rotate(15deg)}.leaf-b{right:5%;top:38%;animation-delay:-2s}.leaf-c{left:10%;top:56%;animation-delay:-5s;font-size:45rpx}
.ripple { position:absolute; z-index:2; width:24rpx; height:24rpx; margin:-12rpx; border:2rpx solid rgba(255,255,255,.75); border-radius:50%; animation:ripple 1.5s ease-out forwards; pointer-events:none; }
@keyframes breathe{50%{transform:scale(1.06);opacity:.78}}@keyframes float{50%{transform:translateX(-50%) translateY(-9rpx) rotate(1deg)}}@keyframes drift{to{transform:translateX(170rpx)}}@keyframes wave{50%{transform:translateY(-7rpx) rotate(2deg)}}@keyframes leaf{50%{transform:translate(14rpx,-18rpx) rotate(9deg);opacity:.7}}@keyframes copyIn{from{opacity:0;transform:translateY(8rpx)}}@keyframes ripple{to{width:240rpx;height:240rpx;margin:-120rpx;opacity:0}}
@media (prefers-reduced-motion: reduce) { .morning-glow,.mist,.character,.welcome-wave,.leaf { animation:none } .character-wrap { opacity:1; transform:none } }