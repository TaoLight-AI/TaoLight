.page{min-height:100vh;padding:calc(env(safe-area-inset-top) + 46rpx) 38rpx 54rpx;background:linear-gradient(180deg,#f7eee5,#edf0df);color:#493a33;box-sizing:border-box}.kicker{color:#a45f70;font-size:20rpx;letter-spacing:4rpx}.title{margin-top:12rpx;font:600 44rpx/1.4 serif}.status-card,.script-card,.platforms,.hint-card,.video-card{margin-top:24rpx;padding:28rpx;border-radius:28rpx;background:#fffaf4;box-shadow:0 14rpx 35rpx rgba(84,62,50,.07)}.status-row{display:flex;justify-content:space-between;color:#705d53;font-size:21rpx}.bar{height:12rpx;margin-top:18rpx;border-radius:999rpx;background:#eadfd4;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#bd6679,#d8a083);transition:width .45s ease}.video-card{padding:0;overflow:hidden}.video-player{display:block;width:100%;height:720rpx;background:#241d1a}.video-note{padding:18rpx 24rpx;color:#765f55;font-size:20rpx}.hint-card{border:1rpx solid rgba(164,95,112,.15)}.hint-card.warning{background:#fff6ed}.hint-title{display:block;color:#9b5c6a;font:600 25rpx serif}.hint-copy{display:block;margin-top:10rpx;color:#725f55;font-size:21rpx;line-height:1.7}.script-title{display:block;font:600 30rpx/1.5 serif}.shot{margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid #eadfd4}.time{display:inline-block;width:84rpx;color:#a45f70;font-size:19rpx}.shot-title{font:600 24rpx serif}.copy{display:block;margin-top:10rpx;color:#6f5f55;font-size:22rpx;line-height:1.75}.final .copy{color:#985d69}.platforms>view+view{margin-top:18rpx}.platform{display:inline-block;padding:7rpx 13rpx;border-radius:999rpx;background:#efe4d8;color:#7b6258;font-size:18rpx}.platform-copy{display:block;margin-top:10rpx;font-size:22rpx;line-height:1.6}.primary{margin-top:30rpx;height:94rpx;border-radius:30rpx;background:linear-gradient(135deg,#bd6679,#d38291);color:#fff;font-size:27rpx;font-weight:600}