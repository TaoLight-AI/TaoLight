.page{min-height:100vh;padding:calc(env(safe-area-inset-top) + 48rpx) 38rpx 52rpx;background:#f7f0e6;color:#493a33;box-sizing:border-box}.kicker{color:#a45f70;font-size:20rpx;letter-spacing:4rpx}.title{margin-top:12rpx;font:600 42rpx/1.45 serif}.poster{position:relative;height:900rpx;margin-top:28rpx;border-radius:34rpx;overflow:hidden;background:linear-gradient(180deg,#d8b5a5,#8a7569);box-shadow:0 24rpx 55rpx rgba(78,58,48,.17)}.poster-bg{position:absolute;inset:0;width:100%;height:100%}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(42,31,26,.08),rgba(47,34,29,.7))}.poster-content{position:absolute;left:34rpx;right:34rpx;bottom:40rpx;color:#fffaf1}.poster-brand{display:block;font-size:18rpx;letter-spacing:3rpx;opacity:.82}.poster-title{display:block;margin-top:20rpx;font:700 46rpx/1.35 serif;text-shadow:0 4rpx 18rpx rgba(0,0,0,.24)}.poster-core{display:block;margin-top:18rpx;font-size:22rpx;line-height:1.7;opacity:.92}.poster-slogan{display:block;margin-top:24rpx;font:600 25rpx/1.6 serif;color:#ffe8cf}.tip{margin-top:22rpx;color:#7d6b61;font-size:20rpx;line-height:1.7}.actions{display:flex;gap:16rpx;margin-top:26rpx}.actions button{flex:1;height:92rpx;border-radius:28rpx;font-size:25rpx}.secondary{background:#efe4d8;color:#6c584f}.primary{background:linear-gradient(135deg,#bd6679,#d38291);color:#fff}