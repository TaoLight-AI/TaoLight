.page{min-height:100vh;padding:calc(env(safe-area-inset-top) + 50rpx) 38rpx 52rpx;background:linear-gradient(180deg,#f8eee6,#eef0df);box-sizing:border-box;color:#493a33}.kicker{color:#a45f70;font-size:20rpx;letter-spacing:4rpx}.title{margin-top:12rpx;font:600 46rpx/1.35 serif}.sub{margin-top:16rpx;color:#7d6c60;font-size:23rpx;line-height:1.7}.story-list{margin-top:34rpx;display:grid;gap:18rpx}.story{display:flex;gap:22rpx;padding:28rpx;border-radius:28rpx;background:#fffaf4;border:2rpx solid transparent;box-shadow:0 14rpx 35rpx rgba(86,64,52,.07)}.story.active{border-color:#c87788;background:#fff5f1;transform:translateY(-2rpx)}.num{color:#b76d7c;font:600 22rpx serif}.body{flex:1}.story-title{display:block;font:600 29rpx/1.5 serif}.core{display:block;margin-top:12rpx;color:#6d5c53;font-size:22rpx;line-height:1.7}.meta{margin-top:18rpx}.emotion{display:inline-block;padding:8rpx 14rpx;border-radius:999rpx;background:#efe4d8;color:#7f685d;font-size:18rpx}.slogan{display:block;margin-top:14rpx;color:#9a5b68;font:500 22rpx/1.6 serif}.primary{margin-top:34rpx;height:96rpx;border:0;border-radius:32rpx;background:linear-gradient(135deg,#bd6679,#d38291);color:#fff;font-size:28rpx;font-weight:600}