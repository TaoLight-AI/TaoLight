<view class="page">
  <view class="kicker">大圣想了三个方向</view>
  <view class="title">哪个故事，最像你？</view>
  <view class="sub">不用改稿，先凭感觉选一个。后面的画面和视频都围绕它来做。</view>

  <view class="story-list">
    <view wx:for="{{stories}}" wx:key="title" data-index="{{index}}" bindtap="selectStory" class="story {{selected===index?'active':''}}">
      <view class="num">0{{index+1}}</view>
      <view class="body">
        <text class="story-title">{{item.title}}</text>
        <text class="core">{{item.core}}</text>
        <view class="meta"><text class="emotion">{{item.emotion}}</text><text class="slogan">“{{item.slogan}}”</text></view>
      </view>
    </view>
  </view>

  <button class="primary" bindtap="confirm">就讲这个故事　→</button>
</view>