.page{min-height:100vh;padding:calc(env(safe-area-inset-top) + 28rpx) 40rpx 52rpx;background:#f7f0e6;color:#493a33;box-sizing:border-box}.topbar{display:flex;align-items:center;gap:18rpx;font-size:25rpx;color:#6e5b50}.back{font-size:52rpx;line-height:1}.guide{margin:34rpx 0 28rpx}.eyebrow{display:block;color:#a45f70;font-size:20rpx;letter-spacing:4rpx}.title{display:block;margin-top:12rpx;font:600 42rpx/1.45 serif}.sub{display:block;margin-top:14rpx;color:#7b6b60;font-size:23rpx;line-height:1.7}.photo-card{height:390rpx;border-radius:32rpx;overflow:hidden;background:#fffaf2;border:2rpx dashed rgba(174,109,122,.38);box-shadow:0 16rpx 42rpx rgba(93,67,53,.08)}.preview{width:100%;height:100%}.photo-empty{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8f6c66;font-size:24rpx}.plus{font-size:70rpx;font-weight:200;margin-bottom:12rpx}.input-card{margin-top:24rpx;padding:28rpx;border-radius:28rpx;background:#fffaf4}.label{display:block;font:600 26rpx/1.5 serif}.input-card textarea{width:100%;height:150rpx;margin-top:18rpx;color:#4f423a;font-size:25rpx;line-height:1.65}.voice{display:inline-block;padding:12rpx 18rpx;border-radius:999rpx;background:#efe4d8;color:#765f54;font-size:21rpx}.soon{opacity:.55;margin-left:8rpx}.section-title{margin:34rpx 0 18rpx;font:600 27rpx serif}.templates{display:grid;grid-template-columns:1fr;gap:14rpx}.template{display:flex;align-items:center;justify-content:space-between;padding:26rpx 28rpx;border-radius:24rpx;background:#fffaf4;border:2rpx solid transparent}.template.active{border-color:#c87788;background:#fff5f1;box-shadow:0 10rpx 25rpx rgba(151,79,96,.1)}.template-title{font:600 26rpx serif}.template-tag{color:#92746c;font-size:20rpx}.primary{margin-top:34rpx;height:96rpx;border:0;border-radius:32rpx;background:linear-gradient(135deg,#bd6679,#d38291);color:#fff;font-size:28rpx;font-weight:600;letter-spacing:2rpx}